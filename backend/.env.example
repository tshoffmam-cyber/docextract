# =============================================================================
# DocExtract — variáveis de ambiente (copie para .env e preencha os valores)
# =============================================================================

# -----------------------------------------------------------------------------
# CHAVES DE IA  (pelo menos uma é OBRIGATÓRIA para processar PDFs)
# -----------------------------------------------------------------------------

# Google Gemini — IA principal (mais barata por token)
# Obtenha em: https://aistudio.google.com/app/apikey
# ATENÇÃO: plano gratuito tem cota muito baixa. Para produção use plano pago.
GEMINI_API_KEY=

# Anthropic Claude — fallback automático quando Gemini esgota cota (429)
# Obtenha em: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# -----------------------------------------------------------------------------
# BANCO DE DADOS
# -----------------------------------------------------------------------------
# Para Railway: copie a CONNECTION STRING do serviço PostgreSQL
# Formato: postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DB
DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/docextract

# -----------------------------------------------------------------------------
# REDIS (broker do Celery)
# -----------------------------------------------------------------------------
# Para Railway: copie a URL do serviço Redis
REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# CLOUDFLARE R2 (armazenamento de PDFs)
# -----------------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=docextract-pdfs
R2_PUBLIC_URL=

# -----------------------------------------------------------------------------
# JWT / AUTENTICAÇÃO
# -----------------------------------------------------------------------------
# Gere um segredo forte: openssl rand -hex 32
JWT_SECRET=TROQUE-ISSO-POR-UM-SEGREDO-FORTE
JWT_EXPIRE_HOURS=24

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
FRONTEND_URL=https://docextract-nine.vercel.app

# -----------------------------------------------------------------------------
# CONFIGURAÇÕES OPCIONAIS
# -----------------------------------------------------------------------------
MAX_PDF_PAGES=50
BATCH_SIZE=20
